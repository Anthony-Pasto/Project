<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Module</title>
</head>

<body>


      <% if (nombre >= 1 && nombre <= 6) { %>

        <h1>Module <%= nombre %></h1>
            <form action="/module/<%= nombre %>" method="POST">

    <div class="form-check form-switch">

        <input
            class="form-check-input"
            type="checkbox"
            name="etat"
            id="module<%= nombre %>"
            <%= donner ? "checked" : "" %>
            onchange="this.form.submit()"
        >

        <label class="form-check-label" for="module<%= nombre %>">
            <%= donner ? "ON" : "OFF" %>
        </label>

    </div>

</form>
 <p>Statut du module : <%= donner ? "on" : "off" %></p>

    <% } else { %>

        <h1>MODULE INCONNU</h1>

    <% } %>


   

    <p> </p><a href="/">Retour à l'accueil</a> </p>

</body>

</html>




